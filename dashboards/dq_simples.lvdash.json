{
  "datasets": [
    {
      "name": "ds_resultados",
      "displayName": "Problemas encontrados",
      "queryLines": [
        "SELECT time_responsavel, tabela, chave_registro, regra, coluna, criticidade, mensagem, executado_em ",
        "FROM dq_resultados"
      ]
    },
    {
      "name": "ds_resumo",
      "displayName": "Resumo por tabela",
      "queryLines": [
        "SELECT time_responsavel, tabela, linhas, linhas_com_erro, linhas_so_com_aviso, linhas_ok, executado_em ",
        "FROM dq_resumo"
      ],
      "columns": [
        {
          "displayName": "% linhas sem erro",
          "description": "linhas sem _errors / total de linhas",
          "expression": "1 - SUM(`linhas_com_erro`) / SUM(`linhas`)"
        }
      ]
    },
    {
      "name": "ds_regras",
      "displayName": "Regras aplicadas (vindas das tags)",
      "queryLines": [
        "SELECT time_responsavel, tabela, coluna, tag, regra, criticidade FROM dq_regras_aplicadas"
      ]
    }
  ],
  "pages": [
    {
      "name": "visao_geral",
      "displayName": "Visão geral",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "titulo",
            "multilineTextboxSpec": {
              "lines": [
                "# Qualidade de dados por time\n",
                "\n",
                "Regras ligadas a **tags** do Unity Catalog → DQX marca a silver (**sem bloquear**) → ",
                "cada time vê aqui e recebe alerta dos problemas dos seus dados."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "f_time",
            "queries": [
              {
                "name": "f_time_ds_resultados",
                "query": {
                  "datasetName": "ds_resultados",
                  "fields": [
                    {
                      "name": "time_responsavel",
                      "expression": "`time_responsavel`"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "f_time_ds_resumo",
                "query": {
                  "datasetName": "ds_resumo",
                  "fields": [
                    {
                      "name": "time_responsavel",
                      "expression": "`time_responsavel`"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "f_time_ds_regras",
                "query": {
                  "datasetName": "ds_regras",
                  "fields": [
                    {
                      "name": "time_responsavel",
                      "expression": "`time_responsavel`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "time_responsavel",
                    "displayName": "Time",
                    "queryName": "f_time_ds_resultados"
                  },
                  {
                    "fieldName": "time_responsavel",
                    "displayName": "Time",
                    "queryName": "f_time_ds_resumo"
                  },
                  {
                    "fieldName": "time_responsavel",
                    "displayName": "Time",
                    "queryName": "f_time_ds_regras"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Time"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "f_tabela",
            "queries": [
              {
                "name": "f_tabela_ds_resultados",
                "query": {
                  "datasetName": "ds_resultados",
                  "fields": [
                    {
                      "name": "tabela",
                      "expression": "`tabela`"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "f_tabela_ds_resumo",
