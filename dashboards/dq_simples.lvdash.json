                  "datasetName": "ds_resumo",
                  "fields": [
                    {
                      "name": "tabela",
                      "expression": "`tabela`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "tabela",
                    "displayName": "Tabela",
                    "queryName": "f_tabela_ds_resultados"
                  },
                  {
                    "fieldName": "tabela",
                    "displayName": "Tabela",
                    "queryName": "f_tabela_ds_resumo"
                  }
                ]
