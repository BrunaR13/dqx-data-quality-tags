                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "time_responsavel",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Time"
                },
                "y": {
                  "fieldName": "count(chave_registro)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Problemas"
                },
                "color": {
                  "fieldName": "criticidade",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      {
                        "value": "error",
                        "color": "#E15759"
                      },
                      {
                        "value": "warn",
                        "color": "#F2B134"
                      }
                    ]
                  },
                  "displayName": "Criticidade"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Problemas por time",
                "description": "error = prioridade alta · warn = aviso",
                "showDescription": true
              }
            }
          },
